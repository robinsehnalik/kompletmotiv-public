---
/**
 * Sanitized Frontend Component Showcase: Construction Progress Timeline
 * 
 * Source Context: stavimesmotivem.cz (vystavba/[slug].astro)
 * Demonstrates:
 * 1. Multi-phase milestone status derivation (isCompleted, isCurrent, upcoming).
 * 2. Visual timeline connector styling with mobile-first vertical progression.
 * 3. Aspect-ratio reserved image slots to eliminate Cumulative Layout Shift (CLS = 0.00).
 */

export interface TimelineMilestone {
  phase: string;
  title: string;
  description?: string;
  isCompleted?: boolean;
  isCurrent?: boolean;
  thumbnailUrl?: string;
}

interface Props {
  milestones: TimelineMilestone[];
  projectTitle: string;
}

const { milestones = [], projectTitle } = Astro.props;
---

<section class="max-w-3xl mx-auto py-8">
  <div class="mb-8">
    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
      Harmonogram realizace
    </span>
    <h2 class="text-2xl font-bold text-slate-900 mt-1 font-sans">
      Průběh výstavby — {projectTitle}
    </h2>
  </div>

  <div class="relative pl-6 sm:pl-8 border-l-2 border-slate-100 space-y-8 sm:space-y-10">
    {
      milestones.map((step) => {
        return (
          <div class="relative group">
            {/* Timeline node marker */}
            <span
              class={`absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full border-2 flex items-center justify-center transition-all ${
                step.isCompleted
                  ? "border-emerald-500 bg-emerald-50"
                  : step.isCurrent
                  ? "border-amber-500 bg-amber-50 ring-4 ring-amber-100/60"
                  : "border-slate-300 bg-white"
              }`}
            >
              {step.isCompleted && <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" />}
              {step.isCurrent && <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse" />}
              {!step.isCompleted && !step.isCurrent && <span class="w-1.5 h-1.5 rounded-full bg-slate-300" />}
            </span>

            <div class="flex flex-col md:flex-row gap-4 md:gap-6 bg-slate-50/60 border border-slate-100 rounded-xl p-5 hover:bg-slate-50 transition-colors">
              <div class="flex-grow">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                  {step.phase}
                </span>
                <h3
                  class={`text-base font-bold mt-0.5 ${
                    step.isCompleted
                      ? "text-slate-700"
                      : step.isCurrent
                      ? "text-slate-950 font-extrabold"
                      : "text-slate-400"
                  }`}
                >
                  {step.title}
                  {step.isCurrent && (
                    <span class="inline-flex items-center align-middle whitespace-nowrap ml-2 text-[10px] font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                      Aktuální fáze
                    </span>
                  )}
                </h3>
                {step.description && (
                  <p class="text-slate-500 text-sm mt-1.5 leading-relaxed">
                    {step.description}
                  </p>
                )}
              </div>

              {step.thumbnailUrl && (
                <div class="w-full md:w-36 aspect-video md:aspect-4/3 overflow-hidden rounded-lg border border-slate-200/60 bg-slate-100 shrink-0">
                  <img
                    src={step.thumbnailUrl}
                    alt={step.title}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
                  />
                </div>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
